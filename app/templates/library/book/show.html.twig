{% extends 'base.html.twig' %}


{# SEO #}

{% set pageHeadTitle = 'Book' %}


{# Assets #}

{% block importmap %}
    {{ importmap(['app', 'product-delete']) }}
{% endblock %}


{# Body #}

{% block main %}
    <div class="container">
        <h1>Book</h1>

        <div class="card">
            <h5 class="card-header">{{ book.title }}</h5>

            <div class="card-body">
                <p class="card-text">From {{ book.author.firstname }} {{ book.author.lastname }}</p>
            </div>

            <div class="card-footer">
                <a href="{{ path('library_book_index') }}" class="btn btn-secondary">
                    back to list
                </a>

                <a href="{{ path('library_book_edit', {'id': book.id}) }}" class="btn btn-primary">
                    edit
                </a>

                {{ include('library/book/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
{% endblock %}
