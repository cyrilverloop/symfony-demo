<form method="post" action="{{ path('clothing_coat_delete', {'id': coat.id}) }}"
    id="delete_product_form" class="d-inline-block"
    data-delete-message="{{ 'confirmDelete'|trans({}, translationContext) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ coat.id) }}" />
    <button class="btn btn-primary">Delete</button>
</form>
